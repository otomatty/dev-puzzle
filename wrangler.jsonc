{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "robozzle",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-19",
  // Better Auth が AsyncLocalStorage と node:crypto を使う
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "assets": {
    // React の SPA を静的配信し、/api/* だけ Worker で処理する
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "robozzle",
      "database_id": "8bd14ad9-6f6d-4875-aa07-c226aa30064b",
      "migrations_dir": "migrations"
    }
  ],
  // Better Auth の署名・暗号化の鍵と、Google ログインの OAuth クライアント。
  // ローカルは .dev.vars、本番は `wrangler secret put` で設定する
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
  },
  "observability": {
    "enabled": true
  }
}
